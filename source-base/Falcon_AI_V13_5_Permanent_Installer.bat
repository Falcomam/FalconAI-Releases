@echo off
setlocal
title Falcon AI V13.5 - Permanent Installer
set "FALCON_SELF_INSTALLER=%~f0"
echo FALCON AI V13.5 - ONE PERMANENT INSTALLATION
echo No Administrator privileges needed. Existing Falcon folders are not deleted.
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop';try{$t=[IO.File]::ReadAllText($env:FALCON_SELF_INSTALLER,[Text.Encoding]::ASCII);$m=[regex]::Match($t,'(?ms)^::FALCON_ARCHIVE_BEGIN\r?\n(.*?)\r?\n::FALCON_ARCHIVE_END');if(-not $m.Success){throw 'Embedded Falcon archive missing'};$raw=[Convert]::FromBase64String(($m.Groups[1].Value -replace '\s',''));$sha=[BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash($raw)).Replace('-','').ToLowerInvariant();if($sha -ne '6d3c24b7eece6e69954851f26bc83e2d7a0dd5a5d16e62041c9025150697022f'){throw 'Installer checksum verification failed'};$parent=Join-Path $env:LOCALAPPDATA 'Programs';$destination=Join-Path $parent 'FalconAI';[void](New-Item -ItemType Directory -Force -Path $parent);if(Test-Path -LiteralPath $destination){if(-not(Test-Path -LiteralPath (Join-Path $destination 'RELEASE_VERSION.txt')) -or -not(Test-Path -LiteralPath (Join-Path $destination 'START_HERE.bat'))){throw 'Falcon installation folder exists but appears incomplete. Copy error to ChatGPT; no files changed.'};Write-Host ('[OK] Falcon already installed: '+$destination) -ForegroundColor Green;Write-Host 'No extra folder or reinstall created. Launching the existing app.';Start-Process -FilePath (Join-Path $destination 'START_HERE.bat') -WorkingDirectory $destination;exit 0};$scratch=Join-Path $parent ('_FalconSetup_'+[guid]::NewGuid().ToString('N').Substring(0,8));$zipfile=$scratch+'.zip';try{[IO.File]::WriteAllBytes($zipfile,$raw);Expand-Archive -LiteralPath $zipfile -DestinationPath $scratch -Force;$folder=Join-Path $scratch 'Falcon_AI_V13_5';foreach($f in @('START_HERE.bat','falcon_launcher.py','RELEASE_VERSION.txt','APPLY_RELEASE_UPDATE.ps1','RESTORE_PREVIOUS_RELEASE.bat')){if(-not(Test-Path -LiteralPath (Join-Path $folder $f))){throw ('Incomplete Falcon installation: '+$f)}};if((Get-Content -LiteralPath (Join-Path $folder 'RELEASE_VERSION.txt') -Raw).Trim() -ne '13.5.0'){throw 'Wrong Falcon release version'};Move-Item -LiteralPath $folder -Destination $destination;Write-Host ('[OK] Permanent Falcon installed: '+$destination) -ForegroundColor Green;try{$start=Join-Path $env:APPDATA 'Microsoft\Windows\Start Menu\Programs';[void](New-Item -ItemType Directory -Force -Path $start);$shortcut=(New-Object -ComObject WScript.Shell).CreateShortcut((Join-Path $start 'Falcon AI.lnk'));$shortcut.TargetPath=Join-Path $destination 'START_HERE.bat';$shortcut.WorkingDirectory=$destination;$shortcut.Description='Falcon AI local command center';$shortcut.Save();Write-Host '[OK] Start Menu shortcut created'}catch{Write-Host ('[WARNING] Shortcut not created: '+$_.Exception.Message)}}finally{Remove-Item -LiteralPath $zipfile -Force -ErrorAction SilentlyContinue;Remove-Item -LiteralPath $scratch -Recurse -Force -ErrorAction SilentlyContinue};Start-Process -FilePath (Join-Path $destination 'START_HERE.bat') -WorkingDirectory $destination}catch{Write-Host ('INSTALL FAILED: '+$_.Exception.Message) -ForegroundColor Red;exit 1}"
if errorlevel 1 (
  echo [ERROR] Setup failed. Copy the error above into ChatGPT.
  pause
  exit /b 1
)
exit /b 0
